# Paste these four lines into the environment's "Environment variables" box,
# replacing each placeholder with the real value. Do not commit real values.
ENCRYPTION_KEY=<paste Fernet key used to create Input/tasks.csv.enc>
CEREBRUM_EMAIL=<your Cerebrum P3 login email>
CEREBRUM_PASSWORD=<your Cerebrum P3 password>
# Base/login URL of Cerebrum P3 (host must be allowed by the environment network policy).
CEREBRUM_URL=<Cerebrum P3 URL>
